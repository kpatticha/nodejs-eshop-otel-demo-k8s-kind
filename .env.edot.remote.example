# Profile "remote": a remote Elasticsearch (oblt-cli cluster, Elastic Cloud, ...).
# Copy to .env.edot.remote (gitignored), then: ./scripts/install-edot.sh remote
#
# Use the endpoint the cluster's own Kibana onboarding page shows. If you run Kibana
# locally against a remote ES, the onboarding page already shows the remote URL.
# The cluster must be reachable from your Mac's network (VPN if required).
ELASTIC_ENDPOINT='https://<cluster-id>.es.<region>.<provider>.elastic-cloud.com:443'
ELASTIC_API_KEY='<elastic_api_key from the onboarding page>'
ONBOARDING_ID='<onboarding.id value from the onboarding page>'
